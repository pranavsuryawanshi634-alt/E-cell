# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite local or PostgreSQL for production)
# SQLite (Local default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ecell_db?schema=public"

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# File Upload Storage
UPLOAD_DIR=uploads
