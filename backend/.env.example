# =====================================================================
# E-Cell SITRC Backend Environment Variables Configuration Template
# =====================================================================

# Server Port (Auto-assigned by Render/Railway in production; default 5000 for local dev)
PORT=5000
NODE_ENV=development # Set to "production" in deployed environment

# Database Connection (Neon Serverless PostgreSQL)
# 1. DATABASE_URL: Neon Pooled Connection (recommended for application runtime / PgBouncer)
# Example: postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Neon Direct Connection (for Prisma migrations & schema pushes)
# Example: postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# (Legacy SQLite Local Fallback):
# DATABASE_URL="file:./dev.db"

# Authentication Secrets
# CRITICAL: Generate a strong 64-char random string in production (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Frontend Origin(s)
# Local: http://localhost:5173
# Production: Set to your live frontend URL (comma-separated if multiple, e.g. https://ecell-sitrc.vercel.app,https://ecell.sitrc.ac.in)
FRONTEND_URL=http://localhost:5173

# File Upload Storage (Local directory or persistent disk mount path)
UPLOAD_DIR=uploads
