# =====================================================================
# E-Cell SITRC Backend Environment Variables Configuration Template
# =====================================================================

# Server Port (Auto-assigned by Render/Railway in production; default 5000 for local dev)
PORT=5000
NODE_ENV=development # Set to "production" in deployed environment

# Database Connection
# SQLite Local (Default):
DATABASE_URL="file:./dev.db"
# SQLite Production with Persistent Disk on Render/Railway (e.g., volume mounted at /data):
# DATABASE_URL="file:/data/dev.db"
# Optional PostgreSQL (Supabase / Neon / Render Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/ecell_db?schema=public"

# Authentication Secrets
# CRITICAL: Generate a strong 64-char random string in production (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Frontend Origin(s)
# Local: http://localhost:5173
# Production: Set to your live frontend URL (comma-separated if multiple, e.g. https://ecell-sitrc.vercel.app,https://ecell.sitrc.ac.in)
FRONTEND_URL=http://localhost:5173

# File Upload Storage (Local directory or persistent disk mount path)
UPLOAD_DIR=uploads
